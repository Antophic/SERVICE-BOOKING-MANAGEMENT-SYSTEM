# Frontend
VITE_API_URL=http://localhost:4000/api

# Backend
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATA_STORE=memory
DATABASE_URL=mysql://serviceflow_user:serviceflow_password@localhost:3306/serviceflow
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=serviceflow_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PUBLIC_BOOKING_RATE_LIMIT_MAX=20
BUSINESS_TIMEZONE=Asia/Jakarta
CSRF_COOKIE_NAME=serviceflow_csrf
CSRF_HEADER_NAME=x-csrf-token
