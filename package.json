{
  "name": "serviceflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "npm --prefix backend run dev",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix backend run build",
    "build:all": "npm run build && npm run build:api",
    "typecheck": "tsc -b",
    "typecheck:api": "npm --prefix backend run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:api",
    "lint": "eslint src api --ext .ts,.tsx",
    "lint:api": "eslint backend/src backend/tests backend/prisma --ext .ts",
    "lint:all": "npm run lint && npm run lint:api",
    "test": "vitest run",
    "test:api": "npm --prefix backend test",
    "test:all": "npm test && npm run test:api",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
